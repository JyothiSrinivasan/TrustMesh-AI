    {
      "parameters": {
        "modelId": {
          "__rl": true,
          "value": "qwen2.5:3b",
          "mode": "id"
        },
        "messages": {
          "values": [
            {
              "content": "You are TrustMesh AI's Device & Context Intelligence Agent.\n\nAnalyze device trust and access context using the supplied event data.\n\nExamine device trust status, operating system, access location, access time, and the supplied policy decision.\n\nExplain potential security risks and recommend appropriate verification or remediation steps.\n\nDo not invent missing evidence. Do not change or override the supplied policy decision. Never claim to have performed a device scan or security enforcement.\n\nReturn a concise professional response with:\n1. Device Risk Assessment\n2. Context Analysis\n3. Recommended Security Action\n\nAlways recommend concrete verification or remediation steps\nfor untrusted devices, even when access is already denied.\nNever recommend granting access without successful device\nverification and policy reevaluation.\nDo not assume that location or access time is suspicious\nwithout evidence or a defined policy.\nTreat the supplied policy decision as an input, not as an\nindependently verified security decision.\n"
            },
            {
              "content": "=\n{{ \"Analyze this device access event:\\nUser: \" + $json.user_id + \"\\nDevice: \" + $json.device_id + \"\\nResource: \" + $json.resource_id + \"\\nDevice trusted: \" + $json.device_trusted + \"\\nOperating system: \" + $json.device_os + \"\\nLocation: \" + $json.location + \"\\nAccess time: \" + $json.access_time + \"\\nPolicy decision: \" + $json.decision + \"\\nPolicy reason: \" + $json.reason }}\n"
            }
          ]
        },
        "options": {}
      },
      "type": "@n8n/n8n-nodes-langchain.ollama",
      "typeVersion": 1,
