        "responseBody": "=\n{{ JSON.stringify({\n  user_id: $('Edit Fields').first().json.user_id,\n  device_id: $('Edit Fields').first().json.device_id,\n  resource_id: $('Edit Fields').first().json.resource_id,\n  decision: $('Edit Fields').first().json.decision,\n  reason: $('Edit Fields').first().json.reason,\n  ai_analysis: $json.content\n}) }}\n",
